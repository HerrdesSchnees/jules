# Jules IMAP Worker - Environment Configuration
# Copy this file to .env for local use. .env is ignored by git.

# ------------------------------------------------------------
# Shared worker settings
# ------------------------------------------------------------
JULES_MODE=simulation
LOG_LEVEL=DEBUG
DRY_RUN=true
CHECK_INTERVAL=300
RSPAMD_URL=http://jules-rspamd:11334
IMAP_MAILBOX=INBOX
JUNK_MAILBOX=Junk

# ------------------------------------------------------------
# Simulation profile (default)
# Uses the local Dovecot container and bundled test mails.
# ------------------------------------------------------------
IMAP_SERVER=jules-dovecot
IMAP_PORT=143
IMAP_USER=vagrant
IMAP_PASS=vagrant
IMAP_SSL=false

# ------------------------------------------------------------
# Real IMAP profile example (A1)
# Uncomment and adapt these values locally after pull.
# Never commit real credentials.
# ------------------------------------------------------------
# JULES_MODE=real
# DRY_RUN=true
# IMAP_SERVER=imap.a1.net
# IMAP_PORT=993
# IMAP_USER=your-email@a1.net
# IMAP_PASS=your-app-password
# IMAP_SSL=true
# IMAP_MAILBOX=INBOX
# JUNK_MAILBOX=Junk
