# Jules IMAP Worker - Environment Configuration
# Copy to .env and fill in real values for production use

# Operation Mode: simulation | real
JULES_MODE=simulation

# IMAP Settings (for real mode)
IMAP_SERVER=imap.a1.net
IMAP_PORT=993
IMAP_USER=your-email@a1.net
IMAP_PASS=your-app-password
IMAP_SSL=true

# Rspamd Settings
RSPAMD_URL=http://jules-rspamd:11334

# Worker Settings
LOG_LEVEL=INFO
DRY_RUN=false
CHECK_INTERVAL=300

# Score Thresholds
SPAM_THRESHOLD=6.0
HAM_THRESHOLD=2.0
