# IMAP-Worker Configuration
# Simulation Mode
WORKER_MODE=simulation
LOG_LEVEL=DEBUG

# IMAP Settings (Simulation default)
IMAP_SERVER=dovecot
IMAP_PORT=143
IMAP_USER=test@example.com
IMAP_PASSWORD=testpass
IMAP_MAILBOX=INBOX
IMAP_USE_SSL=False

# Rspamd Settings
RSPAMD_URL=http://rspamd:11333/checkv2
RSPAMD_PASSWORD=password

# Persistence
DATABASE_PATH=/app/data/state/worker_state.db
LOG_PATH=/app/logs/worker.log
