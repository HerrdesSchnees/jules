# Jules IMAP Worker - Environment Configuration
# Copy this file to .env for local use. .env is ignored by git.
# Default profile: direct A1 IMAP dry-run (no message moves).

# ------------------------------------------------------------
# Worker settings
# ------------------------------------------------------------
JULES_MODE=real
LOG_LEVEL=DEBUG
DRY_RUN=true
CHECK_INTERVAL=300
RSPAMD_URL=http://jules-rspamd:11334
RSPAMD_PASSWORD=jbe72cYFdKZCM-VuZ3jR
IMAP_MAILBOX=INBOX
JUNK_MAILBOX=Junk

# ------------------------------------------------------------
# Direct IMAP profile (A1)
# Fill in real values locally only.
# Never commit credentials.
# ------------------------------------------------------------
IMAP_SERVER=imap.a1.net
IMAP_PORT=993
IMAP_USER=your-email@a1.net
IMAP_PASS=your-password-or-app-password
IMAP_SSL=true

# ------------------------------------------------------------
# Optional local simulation profile (disabled by default)
# Uncomment and adapt only if you later reintroduce a local IMAP source.
# ------------------------------------------------------------
# JULES_MODE=simulation
# IMAP_SERVER=localhost
# IMAP_PORT=143
# IMAP_USER=test@example.invalid
# IMAP_PASS=testpass
# IMAP_SSL=false
